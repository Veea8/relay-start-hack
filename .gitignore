# Data. Everything under data/ stays local except data/raw/,
# which holds the public synthetic case data from the partner.
data/*
*.csv
*.parquet
*.xlsx
*.pkl
*.feather
*.h5
!data/raw/
!data/raw/**

# Secrets
.env
.env.local
.env.*.local

# Submission assets. The thumbnail and the deck belong in the repository,
# the video and the project archive go to the Hack App instead.
*.zip
*.mp4
*.mov

# Local notes and paperwork
context/
admin/

# Python environment and caches
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/

# Frontend dependencies and builds
node_modules/
dist/
build/
.vite/

# Local tooling config
.claude/
CLAUDE.md

# Editor and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
