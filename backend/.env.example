# Copy this file to .env in the same folder and fill in the empty values.
# Never commit the filled-in copy.

# Authorization service
LEASH_BASE_URL=https://saw26api.ashyground-364e1d07.switzerlandnorth.azurecontainerapps.io
TEAM_API_KEY=

# Language model provider, any OpenAI-compatible endpoint
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Time budgets in milliseconds
ENGINE_BUDGET_MS=6000
LLM_BUDGET_MS=2500

# Behavior switches
# GOAL_FULFILLED_ACTION accepts off, note or step_up
# INJECTION_ACTION accepts step_up or decline
GOAL_FULFILLED_ACTION=note
INJECTION_ACTION=step_up

# Share of a limit by which a purchase may exceed it and still be put to the customer, from 0 to 1
OVERSHOOT_TOLERANCE_SHARE=0.10
